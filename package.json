{
  "name": "pafia-site",
  "version": "1.0.0",
  "private": true,
  "description": "Сайт салона-парикмахерской «Пафия», Минск, ул. Притыцкого, 73",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "edit": "node tools/editor.mjs",
    "build:single": "node build.mjs && node build-single.mjs",
